# Copy to .env.local. Never commit real keys.

# 1 = serve banks from /seed; runs with no Supabase and no LLM key.
DEMO_MODE=1

# LLM (provider decided at hour 0; server only)
LLM_API_KEY=
LLM_MODEL=

# Supabase (optional adapter behind lib/store.ts)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Never expose to the client.
SUPABASE_SERVICE_ROLE_KEY=

# Abuse and cost protection
MAX_WORDS=3000
DAILY_GENERATION_LIMIT=50
