# Copy to .env.local. Never commit real keys.

# 1 = serve banks from /seed; runs with no Supabase and no LLM key.
# Anything else uses Supabase and needs the two Supabase values below.
DEMO_MODE=1

# Gemini API key (server only). Leave blank to use the mock generator.
LLM_API_KEY=
# Blank uses gemini-3.5-flash-lite. Any other model needs a row in lib/cost.ts.
LLM_MODEL=

# Free key from pixabay.com/api/docs for video backgrounds (server only).
# Blank leaves chapters on plain backgrounds.
PIXABAY_API_KEY=

# Supabase (backend behind lib/store.ts)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Never expose to the client. Project Settings -> API Keys.
SUPABASE_SERVICE_ROLE_KEY=

# Abuse and cost protection
MAX_WORDS=3000
DAILY_GENERATION_LIMIT=50
